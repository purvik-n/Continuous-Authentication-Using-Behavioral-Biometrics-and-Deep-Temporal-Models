# TrustLoop Security & Network Environment Configuration

# JWT Secret and Algorithm
JWT_SECRET=trustloop_super_secret_production_key_change_me_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Continuous Network Monitoring Configuration
TOR_EXIT_LIST_URL=https://check.torproject.org/torbulkexitlist
IP_API_TIMEOUT_SECONDS=3
NETWORK_CHECK_INTERVAL_SECONDS=5

# Rate Limiting & Brute-Force Protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=120

# Default Seed Credentials (Initial DB setup only)
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_EMP1_PASSWORD=password123
DEFAULT_EMP2_PASSWORD=password456
